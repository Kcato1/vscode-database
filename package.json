{
    "name": "vscode-database",
    "displayName": "vscode-database",
    "description": "Support MySQL, MariaDB, PostgreSQL, SQL Server, SQLite - SSL, socket - query history, formatting, editable results",
    "version": "2.3.0",
    "publisher": "bajdzis",
    "scripts": {
        "lint": "eslint src --ext .ts",
        "vscode:prepublish": "webpack --mode production",
        "webpack:profile": "webpack --mode production --profile --json > stats.json",
        "watch": "tsc -watch -p ./",
        "test:unit": "jest",
        "test": "npm run test-compile && jest && npm run lint",
        "webpack": "webpack --mode development",
        "webpack-dev": "webpack --mode development --watch",
        "test-compile": "tsc -p ./test/"
    },
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.46.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "*"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Bajdzis/vscode-database.git"
    },
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "databaseExplorer",
                    "title": "Databases",
                    "icon": "icons/sidePanel/database.svg"
                }
            ]
        },
        "views": {
            "databaseExplorer": [
                {
                    "id": "Connections",
                    "name": "SQL Connections",
                    "when": "MinimumOneConnectionIsOnline"
                },
                {
                    "id": "Table",
                    "name": "SQL Table",
                    "when": "MinimumOneTableInStructure"
                },
                {
                    "id": "SQLTemplates",
                    "name": "SQL Templates"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "Database configuration",
            "properties": {
                "database.connections": {
                    "type": "array",
                    "default": [],
                    "description": "Array of object with data to connect server on run editor or change workspace"
                },
                "database.format.indent": {
                    "type": "number",
                    "default": 4,
                    "description": "Spaces used to indent formatted SQL"
                },
                "database.format.uppercaseKeywords": {
                    "type": "boolean",
                    "default": true,
                    "description": "Convert SQL keywords to upper case when formatting"
                }
            }
        },
        "commands": [
            {
                "command": "extension.connectToSQLServer",
                "category": "SQL",
                "title": "Connect to MySQL / PostgreSQL server"
            },
            {
                "command": "extension.changeDB",
                "category": "SQL",
                "title": "Select database"
            },
            {
                "command": "extension.changeServer",
                "category": "SQL",
                "title": "Change connected server"
            },
            {
                "command": "extension.querySQL",
                "title": "Query",
                "category": "SQL"
            },
            {
                "command": "extension.queryFileSQL",
                "title": "Run file as query",
                "category": "SQL",
                "icon": {
                    "dark": "icons/dark/database.svg",
                    "light": "icons/light/database.svg"
                }
            },
            {
                "command": "extension.queryFileSQLToCSV",
                "title": "Run file as query with CSV result",
                "category": "SQL",
                "icon": {
                    "dark": "icons/dark/database.svg",
                    "light": "icons/light/database.svg"
                }
            },
            {
                "command": "extension.querySelectedSQL",
                "category": "SQL",
                "title": "Run selected text as SQL query"
            },
            {
                "command": "extension.querySelectedSQLToCSV",
                "category": "SQL",
                "title": "Run selected text as SQL query with CSV result"
            },
            {
                "command": "extension.queryBuild",
                "category": "SQL",
                "title": "Query Advancer Build"
            },
            {
                "command": "extension.runQueryBuild",
                "category": "SQL",
                "title": "Run Query Advancer Build"
            },
            {
                "command": "extension.saveConfig",
                "category": "SQL",
                "title": "Save current server"
            },
            {
                "command": "extension.showQueryHistory",
                "category": "SQL",
                "title": "Show query history"
            },
            {
                "command": "extension.toggleReadOnly",
                "category": "SQL",
                "title": "Toggle Read-Only Mode"
            },
            {
                "command": "extension.stopQueries",
                "category": "SQL",
                "title": "Stop Running Queries"
            },
            {
                "command": "extension.formatSQL",
                "category": "SQL",
                "title": "Format query"
            },
            {
                "command": "extension.testConnection",
                "category": "SQL",
                "title": "Test current connection"
            },
            {
                "command": "extension.insertTemplate",
                "title": "Insert Template",
                "category": "SQL"
            },
            {
                "command": "extension.addCustomTemplate",
                "title": "Add Custom Template",
                "category": "SQL"
            },
            {
                "command": "extension.deleteCustomTemplate",
                "title": "Delete Custom Template",
                "category": "SQL"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "extension.querySelectedSQL",
                    "when": "editorHasSelection && editorLangId == 'sql'",
                    "group": "10_mysql"
                },
                {
                    "command": "extension.querySelectedSQLToCSV",
                    "when": "editorHasSelection && editorLangId == 'sql'",
                    "group": "10_mysql"
                },
                {
                    "command": "extension.formatSQL",
                    "when": "editorLangId == 'sql'",
                    "group": "10_mysql"
                }
            ],
            "editor/title": [
                {
                    "command": "extension.queryFileSQL",
                    "when": "editorLangId == 'sql'",
                    "group": "navigation@1"
                },
                {
                    "command": "extension.queryFileSQLToCSV",
                    "when": "editorLangId == 'sql'",
                    "group": "navigation@1"
                }
            ],
            "view/title": [
                {
                    "command": "extension.connectToSQLServer",
                    "when": "view == Connections"
                },
                {
                    "command": "extension.changeDB",
                    "when": "view == Connections"
                },
                {
                    "command": "extension.addCustomTemplate",
                    "when": "view == SQLTemplates",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "extension.deleteCustomTemplate",
                    "when": "viewItem == customTemplate",
                    "group": "inline"
                }
            ]
        },
        "keybindings": [
            {
                "key": "Ctrl+q",
                "command": "extension.querySQL"
            },
            {
                "key": "Alt+q",
                "command": "extension.queryBuild"
            },
            {
                "key": "ctrl+shift+e",
                "mac": "cmd+shift+e",
                "command": "extension.querySelectedSQL",
                "when": "editorTextFocus && editorHasSelection && editorLangId == 'sql'"
            },
            {
                "key": "ctrl+alt+h",
                "mac": "cmd+alt+h",
                "command": "extension.showQueryHistory"
            }
        ],
        "snippets": [
            {
                "language": "sql",
                "path": "./snippets/main.json"
            }
        ]
    },
    "dependencies": {
        "@types/sql.js": "1.4.4",
        "fast-csv": "^2.5.0",
        "fs": "0.0.2",
        "mssql": "12.7.11",
        "mysql": "^2.18.1",
        "pg": "8.11.5",
        "sql-formatter": "4.0.2"
    },
    "devDependencies": {
        "@types/jest": "29.5.12",
        "@types/mocha": "^5.2.7",
        "@types/mysql": "^2.15.13",
        "@types/node": "^10.17.26",
        "@types/pg": "8.11.6",
        "@types/vscode": "^1.46.0",
        "@typescript-eslint/eslint-plugin": "^3.2.0",
        "@typescript-eslint/parser": "^3.2.0",
        "eslint": "^7.2.0",
        "jest": "29.7.0",
        "sql.js": "1.8.0",
        "ts-jest": "29.1.2",
        "ts-loader": "9.5.1",
        "typescript": "4.9.5",
        "webpack": "5.94.0",
        "webpack-cli": "5.1.4"
    }
}