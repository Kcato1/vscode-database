{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es6",
		"outDir": "dist",
		"lib": [
			"es6",
			"dom"
		],
		"sourceMap": true,
		"skipLibCheck": true,
		"rootDir": "src",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedParameters": false,
		"typeRoots" : ["node_modules/@types", "src/typeing"],
	},
	"include": [
		"./src/**/*.ts",
		"./node_modules/@types/pg/index.d.ts",
		"./node_modules/@types/mysql/index.d.ts",

		"./node_modules/mysql/**/*",
		"./node_modules/fast-csv/**/*",
	]
}
